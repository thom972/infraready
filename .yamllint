---
# Configuration yamllint compatible avec ansible-lint.
extends: default

ignore: |
  .ansible/
  inventory/group_vars/*/vault.yml

rules:
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
  # Listes de dictionnaires alignees en colonnes (pare-feu, comptes AD) : lisibilite voulue.
  commas:
    max-spaces-after: -1
